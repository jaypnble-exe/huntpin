{
  "name": "client-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import:places": "node --env-file=.env.local --conditions=react-server --import tsx scripts/import-overture.ts",
    "import:foursquare": "node --env-file=.env.local --conditions=react-server --import tsx scripts/import-foursquare.ts",
    "refresh:places": "node --env-file=.env.local --conditions=react-server --import tsx scripts/refresh-places.ts",
    "rescore:places": "node --env-file=.env.local --conditions=react-server --import tsx scripts/rescore-places.ts",
    "auth:setup": "node --conditions=react-server --import tsx scripts/auth-setup.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.14.0",
    "next": "^15.5.28",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
