# Copy to .env.local and fill in. Never commit .env.local.

# Server-only secret. Never prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

# Kill switch. Disabled by default. Set true only after completing docs/SETUP.md.
PLACES_SEARCH_ENABLED=false

# Field mask tier:
#   ids_only = places.id only. "Text Search Essentials (IDs Only)", listed by
#              Google as unlimited free. Default.
#   pro      = adds displayName + formattedAddress. "Text Search Pro", 5,000
#              free requests/month, then billed. Opt-in only.
PLACES_FIELD_TIER=ids_only

# Safety limits. The server rejects values above 10 and 100 respectively.
MAX_RESULTS_PER_SEARCH=10
MAX_PLACES_REQUESTS_PER_MONTH=10

# Supabase: stores the usage counter, settings, and leads. Required; searches
# are refused if it is missing or unreachable. Run supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: safe in the browser only because RLS is enabled on every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Foursquare OS Places (Places Portal access token). Used only by the import script.
FOURSQUARE_PLACES_TOKEN=

